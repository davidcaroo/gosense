{% comment %}
  Snippet para servir imágenes optimizadas en formato AVIF, WebP con fallback
  
  Parámetros:
  - image: objeto de imagen (requerido)
  - sizes: atributo sizes para responsive (default: '100vw')
  - loading: 'lazy' o 'eager' (default: 'lazy')
  - class: clases CSS opcionales
  - widths: anchos personalizados (default: '375,550,750,1100,1500,1780,2000,3000')
  - quality: calidad de imagen 1-100 (default: 85)
  
  Uso:
  {% render 'responsive-image', 
     image: product.featured_image, 
     sizes: '(min-width: 750px) 50vw, 100vw',
     class: 'product-image' %}
{% endcomment %}

{%- liquid
  assign sizes = sizes | default: '100vw'
  assign loading = loading | default: 'lazy'
  assign widths = widths | default: '375,550,750,1100,1500,1780,2000,3000'
  assign quality = quality | default: 85
  assign widths_array = widths | split: ','
-%}

{%- if image != blank -%}
  <picture class="responsive-image-wrapper">
    {%- comment -%} Formato AVIF - Mejor compresión (hasta 50% mejor que WebP) {%- endcomment -%}
    <source
      srcset="{%- for width in widths_array -%}
        {{ image | image_url: width: width, format: 'avif', quality: quality }} {{ width }}w
        {%- unless forloop.last -%}, {%- endunless -%}
      {%- endfor -%}"
      type="image/avif"
      sizes="{{ sizes }}">
    
    {%- comment -%} Formato WebP - Buen soporte en navegadores {%- endcomment -%}
    <source
      srcset="{%- for width in widths_array -%}
        {{ image | image_url: width: width, format: 'webp', quality: quality }} {{ width }}w
        {%- unless forloop.last -%}, {%- endunless -%}
      {%- endfor -%}"
      type="image/webp"
      sizes="{{ sizes }}">
    
    {%- comment -%} Fallback JPG/PNG para navegadores antiguos {%- endcomment -%}
    <img
      src="{{ image | image_url: width: 800, quality: quality }}"
      srcset="{%- for width in widths_array -%}
        {{ image | image_url: width: width, quality: quality }} {{ width }}w
        {%- unless forloop.last -%}, {%- endunless -%}
      {%- endfor -%}"
      alt="{{ image.alt | escape | default: 'Imagen de producto' }}"
      loading="{{ loading }}"
      width="{{ image.width }}"
      height="{{ image.height }}"
      {%- if class != blank %}class="{{ class }}"{% endif %}
      decoding="async">
  </picture>
{%- else -%}
  {%- comment -%} Imagen placeholder si no hay imagen {%- endcomment -%}
  <div class="responsive-image-placeholder" style="background: #f3f4f6; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center;">
    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3">
      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
      <circle cx="8.5" cy="8.5" r="1.5"/>
      <polyline points="21 15 16 10 5 21"/>
    </svg>
  </div>
{%- endif -%}