{"sections":{"main":{"type":"main-product","blocks":{"vendor":{"type":"text","settings":{"text":"{{ product.vendor }}✅","text_style":"uppercase"}},"title":{"type":"title","settings":{}},"price":{"type":"price","settings":{}},"variant_picker":{"type":"variant_picker","settings":{"picker_type":"button","swatch_shape":"circle"}},"buy_buttons":{"type":"buy_buttons","settings":{"show_dynamic_checkout":true,"show_gift_card_recipient":true}},"custom_liquid_p7VBFA":{"type":"custom_liquid","settings":{"custom_liquid":"<style>\n.social-proof-box {\n  background-color: #ffffff;\n  border-radius: 10px;\n  display: flex;\n  align-items: center;\n  padding: 10px 15px;\n  margin-top: 15px;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.08);\n  font-family: 'Inter', sans-serif;\n}\n.social-proof-avatars {\n  display: flex;\n  margin-right: 10px;\n}\n.social-proof-avatars img {\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  border: 2px solid #fff;\n  margin-left: -8px;\n  box-shadow: 0 0 2px rgba(0,0,0,0.15);\n}\n.social-proof-text {\n  font-size: 14px;\n  color: #1a1a1a;\n}\n.social-proof-text strong {\n  font-weight: 600;\n}\n.social-proof-verified {\n  color: #1D85E8;\n  font-size: 13px;\n  margin: 0 4px;\n}\n<\/style>\n\n{% assign nombres = \"Sofía,Valentina,Laura,Camila,Andrés,Carlos,Felipe,Natalia,María,Julián,Daniela,Sebastián,Carolina,Juan,Paula,Gabriela,Luis,Mateo,Ana,Isabella\" | split: \",\" %}\n\n{% comment %}\nCreamos una \"semilla\" más variable combinando el ID y la longitud del handle.\nAsí el índice cambia incluso si los IDs son parecidos.\n{% endcomment %}\n{% assign seed = product.id | plus: product.handle.size %}\n{% assign index_nombre = seed | modulo: nombres.size %}\n{% assign nombre = nombres[index_nombre] %}\n{% assign compradores = 500 | plus: seed | modulo: 900 | plus: 200 %}\n\n<div class=\"social-proof-box\">\n  <div class=\"social-proof-avatars\">\n    <img src=\"https:\/\/randomuser.me\/api\/portraits\/women\/68.jpg\" alt=\"user1\">\n    <img src=\"