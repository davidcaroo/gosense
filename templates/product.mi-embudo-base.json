cument.querySelectorAll('.collapsible-content').forEach(function(el){\n    el.style.height = '0px';\n  });\n});\n\n\/\/ delegación: escucha clicks en todo el documento y responde si el objetivo es un header\ndocument.addEventListener('click', function(e){\n  var header = e.target.closest('.collapsible-header');\n  if (!header) return;\n  var box = header.closest('.collapsible-box');\n  var content = box.querySelector('.collapsible-content');\n\n  \/\/ toggle clase\n  var isActive = box.classList.toggle('active');\n\n  \/\/ animación slide: ajusta height según scrollHeight\n  if (isActive) {\n    content.style.height = content.scrollHeight + 'px';\n  } else {\n    content.style.height = '0px';\n  }\n});\n<\/script>"}}},"block_order":["vendor","title","price","variant_picker","buy_buttons","custom_liquid_p7VBFA","custom_liquid_YA3x6w"],"settings":{"enable_sticky_info":true,"color_scheme":"scheme-1","media_size":"medium","constrain_to_viewport":true,"media_fit":"contain","gallery_layout":"stacked","mobile_thumbnails":"hide","media_position":"left","image_zoom":"lightbox","hide_variants":false,"enable_video_looping":false,"padding_top":24,"padding_bottom":24}},"related-products":{"type":"related-products","settings":{"heading":"También podría gustarte","heading_size":"h2","products_to_show":4,"columns_desktop":4,"columns_mobile":"2","color_scheme":"scheme-1","image_ratio":"adapt","image_shape":"default","show_secondary_image":false,"show_vendor":false,"show_rating":false,"padding_top":36,"padding_bottom":68}}},"order":["main","related-products"]}