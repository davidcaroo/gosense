{{ 'custom-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #lifestyle-cta-{{ section.id }} .lifestyle-cta-card {
    min-height: {{ section.settings.cta_height_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #lifestyle-cta-{{ section.id }} .lifestyle-cta-card {
      min-height: {{ section.settings.cta_height_desktop }}px;
    }
  }
{%- endstyle -%}

<section id="lifestyle-cta-{{ section.id }}" class="lifestyle-cta-section section-{{ section.id }}-padding">
  <div class="editorial-container">
    <div class="lifestyle-cta-card">
      <!-- Background Image -->
      {%- if section.settings.image != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
          {%- endif -%}
          <img
            src="{{ section.settings.image | image_url: width: 1800 }}"
            alt="{{ section.settings.heading | escape }}"
            class="lifestyle-cta-bg"
            loading="lazy"
            width="1800"
            height="550"
          >
        </picture>
      {%- else -%}
        <img
          src="https://images.unsplash.com/photo-1549298916-b41d501d3772?q=80&w=1800&auto=format&fit=crop"
          alt="{{ section.settings.heading | escape }}"
          class="lifestyle-cta-bg"
          loading="lazy"
          width="1800"
          height="550"
        >
      {%- endif -%}

      <div class="lifestyle-cta-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

      <div class="lifestyle-cta-content">
        {%- if section.settings.heading != blank -%}
          <h2 class="lifestyle-cta-title editorial-serif">
            {{ section.settings.heading | newline_to_br }}
          </h2>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div>
            <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="lifestyle-cta-btn">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle CTA Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Style With Confident\nSteps By Wearing Our Sneakers."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "cta_height_desktop",
      "min": 300,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Desktop Height",
      "default": 420
    },
    {
      "type": "range",
      "id": "cta_height_mobile",
      "min": 250,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Mobile Height",
      "default": 340
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 55
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Lifestyle CTA Banner"
    }
  ]
}
{% endschema %}
