{{ 'custom-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #trending-banner-{{ section.id }} .trending-banner-card {
    min-height: {{ section.settings.banner_height_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #trending-banner-{{ section.id }} .trending-banner-card {
      min-height: {{ section.settings.banner_height_desktop }}px;
    }
  }
{%- endstyle -%}

<section id="trending-banner-{{ section.id }}" class="trending-banner-section section-{{ section.id }}-padding">
  <div class="editorial-container">
    <div class="trending-banner-card">
      <!-- Background Image -->
      {%- if section.settings.image != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
          {%- endif -%}
          <img
            src="{{ section.settings.image | image_url: width: 1800 }}"
            alt="{{ section.settings.heading | escape }}"
            class="trending-banner-bg"
            loading="lazy"
            width="1800"
            height="650"
          >
        </picture>
      {%- else -%}
        <img
          src="https://images.unsplash.com/photo-1518002171953-a080ee817e1f?q=80&w=1800&auto=format&fit=crop"
          alt="{{ section.settings.heading | escape }}"
          class="trending-banner-bg"
          loading="lazy"
          width="1800"
          height="650"
        >
      {%- endif -%}

      <div class="trending-banner-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

      <div class="trending-banner-content">
        {%- if section.settings.heading != blank -%}
          <h2 class="trending-banner-title editorial-serif">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div>
            <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="trending-banner-btn">
              <span>{{ section.settings.button_label }}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trending Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Banner Heading",
      "default": "Trending Now"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Shop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "banner_height_desktop",
      "min": 300,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Desktop Banner Height",
      "default": 400
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "min": 250,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Mobile Banner Height",
      "default": 320
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Trending Banner"
    }
  ]
}
{% endschema %}
