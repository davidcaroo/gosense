<div class="bahari-register-wrapper">
  <div class="bahari-register-card">
    <h2 class="bahari-title">Crear cuenta</h2>
    <p class="bahari-subtitle">Completa tus datos para registrarte</p>
    {% form 'create_customer', id: 'bahari-create-customer' %}
      {{ form.errors | default_errors }}
      
      <!-- Nombre -->
      <div class="bahari-field">
        <label for="first_name">Nombre</label>
        <input id="first_name" name="customer[first_name]" type="text" required>
      </div>
      
      <!-- Apellido -->
      <div class="bahari-field">
        <label for="last_name">Apellido</label>
        <input id="last_name" name="customer[last_name]" type="text" required>
      </div>
      
      <!-- Email -->
      <div class="bahari-field">
        <label for="email">Correo electrónico</label>
        <input id="email" name="customer[email]" type="email" required>
      </div>
      
      <!-- Teléfono -->
      <div class="bahari-field">
        <label for="phone">Número de teléfono</label>
        <input id="phone" name="bahari_phone_temp" type="text" required>
      </div>
      
      <!-- Tipo ID -->
      <div class="bahari-field">
        <label for="id_type">Tipo de identificación</label>
        <select id="id_type" name="bahari_id_type_temp" required>
          <option value="">Selecciona...</option>
          <option value="CC">Cédula de ciudadanía (CC)</option>
          <option value="CE">Cédula de extranjería (CE)</option>
          <option value="Pasaporte">Pasaporte</option>
        </select>
      </div>
      
      <!-- Número ID (SOLO NÚMEROS) -->
      <div class="bahari-field">
        <label for="id_number">Número de identificación</label>
        <input 
          id="id_number" 
          name="bahari_id_number_temp" 
          type="text" 
          inputmode="numeric"
          pattern="[0-9]+"
          required
          title="Solo se permiten números"
        >
        <span class="bahari-field-hint">Solo números, sin espacios ni caracteres especiales</span>
      </div>
      
      <!-- Password -->
      <div class="bahari-field">
        <label for="password">Contraseña</label>
        <input id="password" name="customer[password]" type="password" required minlength="6">
        <span class="bahari-field-hint">Mínimo 6 caracteres</span>
      </div>
      
      <!-- Campo oculto para enviar JSON -->
      <input type="hidden" id="customer_note" name="customer[note]">
      
      <!-- Términos y condiciones -->
      <div class="bahari-checkbox-group">
        <div class="bahari-terms">
          <input type="checkbox" id="terms" required>
          <label for="terms">Acepto los <a href="/policies/terms-of-service" target="_blank">términos y condiciones</a></label>
        </div>
        
        <div class="bahari-terms">
          <input type="checkbox" id="newsletter" name="customer[accepts_marketing]" value="true">
          <label for="newsletter">Acepto recibir noticias, promociones y ofertas</label>
        </div>
      </div>
      
      <!-- Botón -->
      <button type="submit" class="bahari-btn">Crear cuenta</button>
      
      <!-- Link a login -->
      <div class="bahari-login-link">
        ¿Ya tienes cuenta? <a href="{{ routes.account_login_url }}">Inicia sesión</a>
      </div>
      
    {% endform %}
  </div>
</div>

<style>
  .bahari-register-wrapper {
    display: flex;
    justify-content: center;
    padding: 40px 20px;
    min-height: 100vh;
    align-items: center;
  }
  
  .bahari-register-card {
    width: 100%;
    max-width: 500px;
    background: #ffffff;
    padding: 48px 40px 40px;
    border-radius: 20px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07), 0 12px 36px rgba(0, 0, 0, 0.08);
  }
  
  .bahari-title {
    text-align: center;
    font-size: 32px;
    margin-bottom: 12px;
    font-weight: 700;
    color: #0d2b45;
    letter-spacing: -0.5px;
  }
  
  .bahari-subtitle {
    text-align: center;
    margin-bottom: 32px;
    color: #62727f;
    font-size: 15px;
    line-height: 1.5;
  }
  
  .bahari-field {
    margin-bottom: 20px;
    position: relative;
  }
  
  .bahari-field label {
    display: block;
    font-size: 14px;
    margin-bottom: 8px;
    font-weight: 600;
    color: #0d2b45;
    letter-spacing: 0.2px;
    transition: color 0.2s ease;
  }
  
  /* Label rojo cuando el input está en focus */
  .bahari-field input:focus + label,
  .bahari-field select:focus + label,
  .bahari-field:focus-within label {
    color: #c0392b;
  }
  
  .bahari-field input,
  .bahari-field select {
    width: 100%;
    padding: 14px;
    border-radius: 12px;
    border: 2px solid #e2e7ec;
    background: #f7fafc;
    font-size: 15px;
    outline: none;
    transition: all 0.2s ease;
    color: #0d2b45;
  }
  
  .bahari-field input::placeholder,
  .bahari-field select::placeholder {
    color: #a0aab3;
  }
  
  /* Bordes rojos al escribir */
  .bahari-field input:focus,
  .bahari-field select:focus {
    border-color: #c0392b;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(192, 57, 43, 0.12);
  }
  
  /* Hint text debajo de inputs */
  .bahari-field-hint {
    display: block;
    font-size: 12px;
    color: #768894;
    margin-top: 6px;
    font-style: italic;
  }
  
  /* Input inválido */
  .bahari-field input:invalid:not(:placeholder-shown) {
    border-color: #ff6b6b;
  }
  
  /* Checkbox group */
  .bahari-checkbox-group {
    margin: 24px 0;
    padding: 20px;
    background: #f7fafc;
    border-radius: 12px;
    border: 1px solid #e2e7ec;
  }
  
  .bahari-terms {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 14px;
  }
  
  .bahari-terms:last-child {
    margin-bottom: 0;
  }
  
  .bahari-terms input[type="checkbox"] {
    margin-top: 2px;
    width: 18px;
    height: 18px;
    cursor: pointer;
    flex-shrink: 0;
    accent-color: #c0392b;
  }
  
  .bahari-terms label {
    font-size: 14px;
    font-weight: 400;
    color: #0d2b45;
    line-height: 1.5;
    cursor: pointer;
    margin: 0;
  }
  
  .bahari-terms label a {
    color: #c0392b;
    text-decoration: underline;
    font-weight: 600;
  }
  
  .bahari-terms label a:hover {
    color: #9f2d24;
  }
  
  .bahari-btn {
    width: 100%;
    background: #c0392b;
    color: #fff;
    padding: 16px;
    border-radius: 12px;
    font-size: 16px;
    border: none;
    cursor: pointer;
    font-weight: 600;
    letter-spacing: 0.3px;
    transition: all 0.2s ease;
    margin-top: 8px;
  }
  
  .bahari-btn:hover {
    background: #9f2d24;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(192, 57, 43, 0.3);
  }
  
  .bahari-btn:active {
    transform: translateY(0);
  }
  
  .bahari-login-link {
    text-align: center;
    margin-top: 20px;
    font-size: 15px;
    color: #62727f;
  }
  
  .bahari-login-link a {
    color: #c0392b;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }
  
  .bahari-login-link a:hover {
    color: #9f2d24;
    text-decoration: underline;
  }
  
  /* Error messages styling */
  .errors {
    background: #fff0f0;
    border: 1px solid #ffbdbd;
    color: #a33;
    padding: 14px 16px;
    border-radius: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }
  
  /* Responsive */
  @media (max-width: 680px) {
    .bahari-register-card {
      padding: 32px 24px;
    }
    
    .bahari-title {
      font-size: 28px;
    }
    
    .bahari-register-wrapper {
      padding: 20px 16px;
    }
  }
  
  @media (max-width: 480px) {
    .bahari-register-card {
      padding: 28px 20px;
    }
    
    .bahari-checkbox-group {
      padding: 16px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {

    /* 🔎 1. Identificar el formulario REAL de Shopify */
    const form = document.getElementById('bahari-create-customer');


    if (!form) {
      console.warn("No se encontró el formulario de registro");
      return;
    }

    /* 🔎 2. Inputs personalizados */
    const phoneInput = document.getElementById('phone');
    const idTypeInput = document.getElementById('id_type');
    const idNumberInput = document.getElementById('id_number');
    const noteInput = document.getElementById('customer_note');

    /* 🔐 3. Validación en tiempo real SOLO números */
    idNumberInput.addEventListener('input', function (e) {
      this.value = this.value.replace(/[^0-9]/g, '');
    });

    /* 🚀 4. Antes de enviar el formulario */
    form.addEventListener('submit', function (e) {

      const phone = phoneInput.value.trim();
      const id_type = idTypeInput.value.trim();
      const id_number = idNumberInput.value.trim();

      if (!phone || !id_type || !id_number) {
        e.preventDefault();
        alert("Por favor completa todos los campos.");
        return false;
      }

      /* 📌 Crear el JSON exactamente como Shopify lo guarda */
      const json = {
        phone: phone,
        id_type: id_type,
        id_number: id_number
      };

      /* 🧩 Insertarlo en customer[note] */
      noteInput.value = JSON.stringify(json);
    });

  });
</script>
