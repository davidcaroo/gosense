<!-- sections/store-locator.liquid -->
<style>
.store-locator-wrapper {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  padding: 40px 20px;
  max-width: 1400px;
  margin: 0 auto;
}

.store-locator-container {
  display: grid;
  grid-template-columns: 400px 1fr;
  gap: 20px;
  height: 600px;
}

@media (max-width: 1024px) {
  .store-locator-container {
    grid-template-columns: 1fr;
    height: auto;
  }
}

/* Barra de búsqueda */
.search-box {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 12px 16px;
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
}

.search-box input {
  flex: 1;
  border: none;
  outline: none;
  font-size: 0.9375em;
}

.search-box button {
  background: #1e88e5;
  color: white;
  border: none;
  padding: 8px 16px;
  border-radius: 6px;
  cursor: pointer;
  font-weight: 600;
  transition: background 0.3s;
}

.search-box button:hover {
  background: #1565c0;
}

.clear-search {
  background: transparent !important;
  color: #6b7280;
  padding: 4px 8px !important;
  font-size: 1.2em;
}

/* Sidebar con listado */
.stores-sidebar {
  overflow-y: auto;
  padding-right: 10px;
}

.stores-sidebar::-webkit-scrollbar {
  width: 6px;
}

.stores-sidebar::-webkit-scrollbar-thumb {
  background: #cbd5e0;
  border-radius: 3px;
}

/* Cards de tiendas */
.store-card {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 12px;
  cursor: pointer;
  transition: all 0.3s;
}

.store-card:hover,
.store-card.active {
  border-color: #1e88e5;
  box-shadow: 0 4px 12px rgba(30, 136, 229, 0.15);
  transform: translateX(4px);
}

.store-card-header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 12px;
}

.store-number {
  background: #1e88e5;
  color: white;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.875em;
  flex-shrink: 0;
}

.store-info h3 {
  font-size: 1em;
  font-weight: 700;
  color: #1f2937;
  margin: 0 0 4px 0;
}

.store-distance {
  font-size: 0.75em;
  color: #10b981;
  font-weight: 600;
}

.store-address {
  font-size: 0.875em;
  color: #6b7280;
  line-height: 1.5;
  margin-bottom: 8px;
  padding-left: 44px;
}

.store-hours {
  font-size: 0.8125em;
  color: #6b7280;
  padding-left: 44px;
  margin-bottom: 12px;
}

.store-actions {
  display: flex;
  gap: 8px;
  padding-left: 44px;
  flex-wrap: wrap;
}

.store-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: 6px;
  font-size: 0.8125em;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s;
  border: none;
  cursor: pointer;
}

.btn-directions {
  background: #1e88e5;
  color: white;
}

.btn-directions:hover {
  background: #1565c0;
}

.btn-website {
  background: transparent;
  color: #1e88e5;
  border: 1px solid #1e88e5;
}

.btn-website:hover {
  background: #e3f2fd;
}

.btn-whatsapp {
  background: #25d366;
  color: white;
}

.btn-whatsapp:hover {
  background: #1da851;
}

/* Mapa */
.map-container {
  background: #f3f4f6;
  border-radius: 12px;
  overflow: hidden;
  position: relative;
  height: 100%;
  min-height: 500px;
}

#map {
  width: 100%;
  height: 100%;
}

.location-btn {
  position: absolute;
  top: 16px;
  right: 16px;
  background: white;
  border: none;
  padding: 12px;
  border-radius: 8px;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  z-index: 1000;
  transition: all 0.3s;
}

.location-btn:hover {
  background: #f3f4f6;
  transform: scale(1.05);
}

.location-btn svg {
  display: block;
}

/* Info Window personalizada */
.custom-info-window {
  padding: 12px;
  max-width: 280px;
}

.custom-info-window h3 {
  font-size: 1em;
  font-weight: 700;
  color: #1f2937;
  margin: 0 0 8px 0;
}

.custom-info-window p {
  font-size: 0.875em;
  color: #6b7280;
  margin: 4px 0;
  line-height: 1.5;
}

.custom-info-window a {
  display: inline-block;
  margin-top: 8px;
  color: #1e88e5;
  font-weight: 600;
  font-size: 0.875em;
  text-decoration: none;
}

.custom-info-window a:hover {
  text-decoration: underline;
}

/* Loading y mensajes */
.loading-message,
.no-results {
  text-align: center;
  padding: 40px 20px;
  color: #6b7280;
}

.loading-message {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.spinner {
  width: 40px;
  height: 40px;
  border: 4px solid #e5e7eb;
  border-top-color: #1e88e5;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 1024px) {
  .map-container {
    min-height: 400px;
    order: -1;
  }
}
</style>

<div class="store-locator-wrapper">
