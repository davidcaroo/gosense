          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </button>
      <div id="map"></div>
    </div>
  </div>
</div>

<script>
// Datos de las tiendas
const stores = [
  {
    id: 1,
    name: "Mall Plaza Cartagena",
    address: "Av. Pedro De Heredia #Carrera 13",
    city: "Cartagena",
    lat: 10.3997200,
    lng: -75.4794400,
